# Copie para .env e ajuste. Todas sao opcionais (os valores abaixo sao os padroes).
SERVER_PORT=8080
DB_PATH=./data/qfome.db
# always: roda schema.sql e data.sql a cada start; never: nao roda
SQL_INIT_MODE=always
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
APP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE_SECONDS=3600
# never | when-authorized | always
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
